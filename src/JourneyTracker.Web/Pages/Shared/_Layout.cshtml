@inject JourneyTracker.Web.AppInfo AppInfo
@{
    var currentPage = ViewContext.RouteData.Values["page"] as string;
    string Active(string page) => currentPage == page ? "active" : "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Journey Tracker</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="nav-wrap">
        <nav class="site-nav">
            <a class="brand" asp-page="/Index">
                <span class="brand-dot"></span>
                <span>Journey Tracker</span>
            </a>
            <div class="nav-links">
                <a class="@Active("/Index")" asp-page="/Index">Journeys</a>
                <a class="@Active("/History")" asp-page="/History">History</a>
            </div>
            <a class="btn-pill btn-pill-sm" asp-page="/Log">Log activity</a>
        </nav>
    </header>

    <main role="main" class="container page">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container">
            Journey Tracker &middot; SWE40006 Group 5 &middot; Version <span data-testid="commit-sha" title="@AppInfo.CommitSha">@AppInfo.ShortSha</span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
