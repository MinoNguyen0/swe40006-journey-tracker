@page
@model LogModel
@{
    ViewData["Title"] = "Log an activity";
}

<h1>Log an activity</h1>

<form method="post" class="col-md-6" data-testid="log-form">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Input.JourneyId" class="form-label"></label>
        <select asp-for="Input.JourneyId" asp-items="Model.JourneyOptions" class="form-select"></select>
        <span asp-validation-for="Input.JourneyId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Input.Type" class="form-label"></label>
        <select asp-for="Input.Type" asp-items="Html.GetEnumSelectList<ActivityType>()" class="form-select"></select>
    </div>

    <div class="mb-3">
        <label asp-for="Input.DistanceKm" class="form-label"></label>
        <input asp-for="Input.DistanceKm" class="form-control" step="0.01" />
        <span asp-validation-for="Input.DistanceKm" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Input.Date" class="form-label"></label>
        <input asp-for="Input.Date" class="form-control" />
        <span asp-validation-for="Input.Date" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
