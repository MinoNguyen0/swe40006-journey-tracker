@page "{id:int}"
@model ProgressModel
@{
    ViewData["Title"] = Model.Journey.Name;
    var p = Model.Progress;
    var parts = Model.Journey.Name.Split(" to ");
}

<a class="back-link" asp-page="/Index">&larr; All journeys</a>

<section class="progress-hero">
    @if (parts.Length == 2)
    {
        <div class="from">@parts[0] to</div>
        <h1>@parts[1]</h1>
    }
    else
    {
        <h1>@Model.Journey.Name</h1>
    }
    <div class="big-pct">@p.PercentComplete%</div>
    <div class="bar" role="progressbar" aria-valuenow="@p.PercentComplete" aria-valuemin="0" aria-valuemax="100">
        <span style="width: @p.PercentComplete%; background: #f95d51"></span>
    </div>
    @if (p.IsComplete)
    {
        <div class="complete" data-testid="journey-complete">Journey complete!</div>
    }
</section>

<div class="tiles" data-testid="progress-summary">
    <div class="tile">
        <div class="label">Distance travelled</div>
        <div class="value" data-testid="total-distance">@p.TotalDistanceKm.ToString("0.##") of @Model.Journey.TotalDistanceKm.ToString("0") km</div>
    </div>
    <div class="tile">
        <div class="label">Last stop passed</div>
        <div class="value" data-testid="last-stop">@(p.LastStopPassed?.Name ?? "-")</div>
    </div>
    <div class="tile">
        <div class="label">Next stop</div>
        @if (p.IsComplete)
        {
            <div class="value">You made it</div>
        }
        else
        {
            <div class="value" data-testid="next-stop">@p.NextStop?.Name &ndash; @p.DistanceToNextStopKm?.ToString("0.##") km to go</div>
        }
    </div>
</div>

<section class="route">
    <h2>Route</h2>
    <ul class="stops">
        @foreach (var stop in Model.Journey.Stops)
        {
            var reached = stop.DistanceFromStartKm <= p.TotalDistanceKm;
            var current = stop == p.LastStopPassed;
            <li class="@(reached ? "reached" : "") @(current ? "current" : "")">
                <span>@stop.Name</span>
                <span>@stop.DistanceFromStartKm.ToString("0") km</span>
            </li>
        }
    </ul>
</section>

<a class="btn-pill" asp-page="/Log" asp-route-journeyId="@Model.Journey.Id">Log an activity</a>
