@page
@model HistoryModel
@{
    ViewData["Title"] = "History";
}

<h1>Activity history</h1>

@if (Model.Activities.Count == 0)
{
    <p data-testid="history-empty">No activities logged yet. <a asp-page="/Log">Log your first one.</a></p>
}
else
{
    <table class="table" data-testid="history-table">
        <thead>
            <tr><th>Date</th><th>Type</th><th>Distance</th><th>Journey</th></tr>
        </thead>
        <tbody>
            @foreach (var a in Model.Activities)
            {
                <tr>
                    <td>@a.Date.ToString("yyyy-MM-dd")</td>
                    <td>@a.Type</td>
                    <td>@a.DistanceKm.ToString("0.##") km</td>
                    <td>@a.Journey?.Name</td>
                </tr>
            }
        </tbody>
    </table>
}
