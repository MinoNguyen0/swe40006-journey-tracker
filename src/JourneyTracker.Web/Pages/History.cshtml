@page
@model HistoryModel
@{
    ViewData["Title"] = "History";
}

<div class="section-head">
    <h2>Activity history</h2>
    <a class="btn-pill btn-pill-sm" asp-page="/Log">Log activity</a>
</div>

@if (Model.Activities.Count == 0)
{
    <div class="empty" data-testid="history-empty">
        <p>No activities logged yet.</p>
        <a class="btn-pill" asp-page="/Log">Log your first one</a>
    </div>
}
else
{
    <ul class="activity-list" data-testid="history-table">
        @foreach (var a in Model.Activities)
        {
            <li class="activity-row">
                <span class="date">@a.Date.ToString("d MMM yyyy")</span>
                <span class="journey">@a.Journey?.Name</span>
                <span class="km">
                    <span class="badge-type @(a.Type == ActivityType.Walk ? "badge-walk" : "badge-ride")">@a.Type</span>
                    @a.DistanceKm.ToString("0.##") km
                </span>
            </li>
        }
    </ul>
}
