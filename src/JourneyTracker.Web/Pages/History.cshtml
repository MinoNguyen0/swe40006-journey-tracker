@page
@model HistoryModel
@{
    ViewData["Title"] = "History";
}

<div class="section-head">
    <h2>Activity history</h2>
    <a class="btn-pill btn-pill-sm" asp-page="/Log">Log activity</a>
</div>

@if (Model.Activities.Count == 0)
{
    <div class="empty" data-testid="history-empty">
        <p>No activities logged yet.</p>
        <a class="btn-pill" asp-page="/Log">Log your first one.</a>
    </div>
}
else
{
    <table class="activity-table" data-testid="history-table">
        <thead>
            <tr><th>Date</th><th>Type</th><th>Distance</th><th>Journey</th></tr>
        </thead>
        <tbody>
            @foreach (var a in Model.Activities)
            {
                <tr>
                    <td class="date">@a.Date.ToString("d MMM yyyy")</td>
                    <td><span class="badge-type @(a.Type == ActivityType.Walk ? "badge-walk" : "badge-ride")">@a.Type</span></td>
                    <td class="km">@a.DistanceKm.ToString("0.##") km</td>
                    <td class="journey">@a.Journey?.Name</td>
                </tr>
            }
        </tbody>
    </table>
}
