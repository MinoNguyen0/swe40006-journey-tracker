<mxfile host="app.diagrams.net">
  <diagram id="structure" name="1. App structure">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1180" pageHeight="880" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;Virtual Journey Progress Tracker: how the app is structured&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#666666&quot;&gt;ASP.NET Core Razor Pages · EF Core · MySQL&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="800" height="50" as="geometry" />
        </mxCell>
        <mxCell id="browser" value="&lt;b&gt;User's browser&lt;/b&gt;" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="85" y="225" width="40" height="70" as="geometry" />
        </mxCell>
        <mxCell id="program" value="&lt;b&gt;Program.cs&lt;/b&gt;: startup, runs once when the app starts&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;connects to the database · migrates tables · sets up /health · request logging&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="220" y="90" width="560" height="60" as="geometry" />
        </mxCell>
        <mxCell id="pages" value="&lt;b&gt;Pages/&lt;/b&gt;: the screens (each = .cshtml HTML + .cshtml.cs code)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="220" y="180" width="560" height="150" as="geometry" />
        </mxCell>
        <mxCell id="pIndex" value="&lt;b&gt;Index&lt;/b&gt;&lt;br&gt;/&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;choose a journey&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="235" y="225" width="120" height="80" as="geometry" />
        </mxCell>
        <mxCell id="pProgress" value="&lt;b&gt;Progress&lt;/b&gt;&lt;br&gt;/Progress/{id}&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;%, last &amp;amp; next stop&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="370" y="225" width="125" height="80" as="geometry" />
        </mxCell>
        <mxCell id="pLog" value="&lt;b&gt;Log&lt;/b&gt;&lt;br&gt;/Log&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;form to add a walk/ride&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="510" y="225" width="120" height="80" as="geometry" />
        </mxCell>
        <mxCell id="pHistory" value="&lt;b&gt;History&lt;/b&gt;&lt;br&gt;/History&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;list of all activities&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="645" y="225" width="120" height="80" as="geometry" />
        </mxCell>
        <mxCell id="calc" value="&lt;b&gt;Services/ProgressCalculator&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;the maths only: total km, % complete,&lt;br&gt;last stop passed, km to next stop&lt;br&gt;(no database, no HTML → easy to test)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="220" y="390" width="270" height="85" as="geometry" />
        </mxCell>
        <mxCell id="valid" value="&lt;b&gt;Validation/NotInFuture&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;input rules: distance &amp;gt; 0,&lt;br&gt;date can't be in the future&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="530" y="390" width="250" height="85" as="geometry" />
        </mxCell>
        <mxCell id="models" value="&lt;b&gt;Models/&lt;/b&gt;: the shape of the data (no logic)&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Journey (name, total km) · Stop (name, km from start) · Activity (walk/ride, km, date)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="220" y="520" width="560" height="60" as="geometry" />
        </mxCell>
        <mxCell id="data" value="&lt;b&gt;Data/AppDbContext&lt;/b&gt;: talks to MySQL for us (EF Core)&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Journeys · Stops · Activities tables&lt;br&gt;SeedData = the 3 preset journeys&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="220" y="620" width="380" height="80" as="geometry" />
        </mxCell>
        <mxCell id="migr" value="&lt;b&gt;Data/Migrations/&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;auto-generated table changes,&lt;br&gt;don't edit by hand&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="620" y="620" width="160" height="80" as="geometry" />
        </mxCell>
        <mxCell id="mysql" value="&lt;b&gt;MySQL&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;local: Docker container&lt;br&gt;staging/prod: AWS RDS&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="320" y="750" width="180" height="100" as="geometry" />
        </mxCell>
        <mxCell id="tests" value="&lt;b&gt;tests/UnitTests&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;23 xUnit tests&lt;br&gt;check the maths&lt;br&gt;and input rules&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="40" y="392" width="130" height="80" as="geometry" />
        </mxCell>
        <mxCell id="hooks" value="&lt;b&gt;Hooks for the pipeline &amp;amp; AWS&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#666666&quot;&gt;(what Bermi &amp;amp; Nhi plug into)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="840" y="90" width="300" height="610" as="geometry" />
        </mxCell>
        <mxCell id="h1" value="&lt;b&gt;GET /health&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;200 Healthy = app up + DB reachable&lt;br&gt;503 = DB down&lt;br&gt;→ checked after every deploy&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="855" y="145" width="270" height="85" as="geometry" />
        </mxCell>
        <mxCell id="h2" value="&lt;b&gt;Request logs with Duration&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;one line per request, JSON outside dev&lt;br&gt;→ CloudWatch latency metric&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="855" y="245" width="270" height="75" as="geometry" />
        </mxCell>
        <mxCell id="h3" value="&lt;b&gt;COMMIT_SHA&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;set when the image is built&lt;br&gt;→ shown in page footer + /health&lt;br&gt;(proves which version is live)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="855" y="335" width="270" height="85" as="geometry" />
        </mxCell>
        <mxCell id="h4" value="&lt;b&gt;ConnectionStrings__Default&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;env variable, different per environment&lt;br&gt;(staging RDS ≠ production RDS)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="855" y="435" width="270" height="75" as="geometry" />
        </mxCell>
        <mxCell id="h5" value="&lt;b&gt;Migrate on startup&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;app updates its own DB tables when it starts,&lt;br&gt;so prod only migrates after approval&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="855" y="525" width="270" height="75" as="geometry" />
        </mxCell>
        <mxCell id="h6" value="&lt;b&gt;Port 8080 · data-testid tags&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;container port · hooks for Playwright tests&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="855" y="615" width="270" height="65" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="&lt;b&gt;How to read it:&lt;/b&gt; a request comes in from the browser → a Page handles it → the Page uses the Calculator / Validation and loads or saves data through AppDbContext → AppDbContext reads and writes MySQL." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="560" y="740" width="580" height="60" as="geometry" />
        </mxCell>
        <mxCell id="e1" value="HTTP request" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="browser" target="pages">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="calculate progress" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="pProgress" target="calc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="check input" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="pLog" target="valid">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="load / save data" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;exitX=0;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="pages" target="data">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="195" y="293" />
              <mxPoint x="195" y="660" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e5" value="SQL (written by EF Core)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="data" target="mysql">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" value="returns Models" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;dashed=1;fontSize=11;" edge="1" parent="1" source="data" target="models">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" value="tests" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;dashed=1;fontSize=11;strokeColor=#b85450;fontColor=#b85450;" edge="1" parent="1" source="tests" target="calc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8" value="sets up" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;dashed=1;fontSize=11;strokeColor=#9673a6;fontColor=#9673a6;" edge="1" parent="1" source="program" target="hooks">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="flow" name="2. Logging an activity">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t2" value="&lt;b&gt;Example: a user logs a 665 km walk on Hanoi → Ho Chi Minh City&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#666666&quot;&gt;which file does what, step by step&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="900" height="50" as="geometry" />
        </mxCell>
        <mxCell id="c1" value="&lt;b&gt;What the user does&lt;/b&gt;" style="text;html=1;align=center;fontSize=13;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="85" width="220" height="25" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="&lt;b&gt;What the code does&lt;/b&gt;" style="text;html=1;align=center;fontSize=13;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="330" y="85" width="380" height="25" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="&lt;b&gt;Database&lt;/b&gt;" style="text;html=1;align=center;fontSize=13;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="800" y="85" width="220" height="25" as="geometry" />
        </mxCell>
        <mxCell id="u1" value="&lt;b&gt;1.&lt;/b&gt; Opens &lt;b&gt;/Log&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="125" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="s1" value="&lt;b&gt;Log.cshtml.cs → OnGetAsync()&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;loads the journeys for the dropdown,&lt;br&gt;then Log.cshtml shows the form&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="330" y="120" width="380" height="70" as="geometry" />
        </mxCell>
        <mxCell id="u2" value="&lt;b&gt;2.&lt;/b&gt; Enters Walk · 665 km · today,&lt;br&gt;clicks &lt;b&gt;Save&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="225" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="&lt;b&gt;Log.cshtml.cs → OnPostAsync()&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;receives the form values&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="330" y="225" width="380" height="60" as="geometry" />
        </mxCell>
        <mxCell id="d3" value="&lt;b&gt;3. Input valid?&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;distance &amp;gt; 0 · date not in future&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="410" y="315" width="220" height="110" as="geometry" />
        </mxCell>
        <mxCell id="err" value="Page reloads with a&lt;br&gt;&lt;font color=&quot;#b85450&quot;&gt;&lt;b&gt;red error message&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;e.g. &quot;Distance must be greater than 0&quot;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="40" y="335" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="s4" value="&lt;b&gt;4. Save it&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;db.Activities.Add(...)&lt;br&gt;db.SaveChangesAsync()&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="330" y="460" width="380" height="65" as="geometry" />
        </mxCell>
        <mxCell id="db4" value="&lt;b&gt;MySQL&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;new row in Activities&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="840" y="450" width="140" height="85" as="geometry" />
        </mxCell>
        <mxCell id="s5" value="&lt;b&gt;5. Redirect to /Progress/1&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Progress.cshtml.cs → OnGetAsync(id: 1)&lt;br&gt;loads journey 1 + its stops + all its logged distances&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="330" y="560" width="380" height="70" as="geometry" />
        </mxCell>
        <mxCell id="db5" value="&lt;b&gt;MySQL&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;reads Journeys, Stops,&lt;br&gt;Activities&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="840" y="552" width="140" height="85" as="geometry" />
        </mxCell>
        <mxCell id="s6" value="&lt;b&gt;6. ProgressCalculator.Calculate(...)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;665 km travelled · 39.1% · last stop Hue ·&lt;br&gt;next stop Da Nang · 95 km to go&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="330" y="665" width="380" height="70" as="geometry" />
        </mxCell>
        <mxCell id="s7" value="&lt;b&gt;7. Progress.cshtml&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;puts those numbers into the HTML page&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="330" y="770" width="380" height="60" as="geometry" />
        </mxCell>
        <mxCell id="u7" value="Sees the &lt;b&gt;progress bar&lt;/b&gt;:&lt;br&gt;&quot;Hue, 95 km to Da Nang&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="770" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="lg" value="&lt;b&gt;Colours&lt;/b&gt;&lt;br&gt;blue = Pages/ · green = maths &amp;amp; rules · orange = database code" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="770" y="770" width="290" height="60" as="geometry" />
        </mxCell>
        <mxCell id="f1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="u1" target="s1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="u2" target="s2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="s2" target="d3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f4" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontColor=#b85450;strokeColor=#b85450;fontStyle=1;" edge="1" parent="1" source="d3" target="err">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f5" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontColor=#82b366;strokeColor=#82b366;fontStyle=1;" edge="1" parent="1" source="d3" target="s4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f6" value="INSERT" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="s4" target="db4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="s4" target="s5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f8" value="SELECT" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;startArrow=block;startFill=1;" edge="1" parent="1" source="s5" target="db5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="s5" target="s6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="s6" target="s7">
